*----------------------------------------------------------------------
* GPUBMA Phase 1 — Stata validation oracle
* Dataset : data/synthetic/panel_8.dta (frozen, generated by Python)
* Model   : y on optional x1-x8; always-included w1 w2 + INDIVIDUAL dummies
* Fixed effects: individual (100 levels, base = individual_id 1, matching
*                the Python reference which drops the first sorted level)
*
* STATUS: EXECUTED 2026-07-15 in batch mode on StataNow/SE 19.5.
* Option keywords and e() matrix names verified on that run.
*
* Priors fixed to match Python: g = 1000, beta-binomial(1,1) model prior.
* The fixed effects are ALWAYS-included; the candidate model space stays 2^8.
*----------------------------------------------------------------------
version 18
clear all
set more off
set linesize 120
capture mkdir "validation/stata/output"
log using "validation/stata/output/small_individual_fixed_effects.log", replace text

display "Stata version: " c(stata_version)
display "Edition: " c(edition_real)
display "Born: " c(born_date)

use "data/synthetic/panel_8.dta", clear
assert _N == 1000
confirm variable individual_id period y x1 x2 x3 x4 x5 x6 x7 x8 w1 w2
isid individual_id period

* i.individual_id expands to dummies with base level 1 (Stata default =
* lowest value), matching Python's dropped first sorted level.
bmaregress y x1-x8 (w1 w2 i.individual_id, always), ///
    enumeration ///
    gprior(fixed 1000) ///
    mprior(betabinomial 1 1)

ereturn list
bmastats models, top(20)
bmastats pip
bmastats msize

* -- machine-readable exports (no manual copying of output) ------------
* Matrix names confirmed from `ereturn list` on Stata 19.5 (StataNow, SE):
* e(b_bma) = BMA posterior means, e(V_bma) = BMA posterior covariance,
* e(pip) = posterior inclusion probabilities. There is no e(b).
matrix b_bma = e(b_bma)
matrix pip = e(pip)
matrix vdiag = vecdiag(e(V_bma))
local names : colnames e(b_bma)
file open fh using "validation/stata/output/small_individual_fe_colnames.txt", write replace
file write fh `"`names'"'
file close fh
preserve
clear
svmat double b_bma
export delimited using "validation/stata/output/small_individual_fe_b_bma.csv", replace
clear
svmat double pip
export delimited using "validation/stata/output/small_individual_fe_pip.csv", replace
clear
svmat double vdiag
export delimited using "validation/stata/output/small_individual_fe_v_diag.csv", replace
clear
set obs 1
gen double msize_mean = e(msize_mean)
gen double msize_mean_prior = e(msize_mean_prior)
gen double p_always = e(p_always)
gen double p_groups = e(p_groups)
gen double g_used = e(g)
gen double shrinkage = e(shrinkage)
gen double sigma2 = e(sigma2)
gen double k_models = e(k_models)
gen double n_obs = e(N)
export delimited using "validation/stata/output/small_individual_fe_scalars.csv", replace
restore

log close
exit, clear
